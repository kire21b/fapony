{
  "worktrees": {
    "myapp": "/absolute/path/to/myapp"
  },
  "review": {
    "maxRounds": 2
  },
  "memory": null,
  "telemetry": null,
  "paths": {
    "planDir": ".fapony/plan",
    "specDir": ".fapony/spec",
    "memoryEntry": ".fapony/.memory/mem.ts",
    "evidenceFile": ".fapony/evidence.json"
  },
  "safety": {
    "deny": [
      "reset\\s+--hard",
      "clean\\s+-[a-z]*f",
      "checkout\\s+--\\s",
      "git\\s+stash"
    ]
  },
  "usageWeb": {
    "port": 1710,
    "hostname": "127.0.0.1",
    "pollInterval": 1771,
    "ownerName": "your-name"
  },
  "pricing": {
    "executor": { "inputPer1k": 3, "outputPer1k": 15 }
  }
}
